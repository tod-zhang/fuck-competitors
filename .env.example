# Copy to .env to override defaults. All vars are prefixed FC_.
FC_DB_URL=sqlite:///./data/app.db
FC_DEFAULT_INTERVAL_HOURS=12
FC_REQUEST_TIMEOUT=20
FC_MAX_SITEMAP_URLS=50000
FC_SNAPSHOT_RETENTION=10
FC_WRITE_BATCH=200
# FC_USER_AGENT=FuckCompetitors/0.1 (+https://github.com/tod-zhang/fuck-competitors)

# MCP server (app/mcp_server.py): "stdio" (local) or "http" (remote URL)
FC_MCP_TRANSPORT=stdio
FC_MCP_PORT=9528
# FC_MCP_TOKEN=         # set a secret to require Bearer auth — REQUIRED when exposing publicly

# Content feed AI features — each one stays off until its key is set
# FC_MY_DOMAIN=example.com                     # (also editable in the 内容 Feed view)
# FC_MY_SITEMAP_URL=https://example.com/post-sitemap.xml
# DataForSEO (competitor suggestions + keyword data)
# FC_DATAFORSEO_LOGIN=
# FC_DATAFORSEO_PASSWORD=
# FC_DATAFORSEO_LOCATION_CODE=2840             # 2840 = United States
# FC_DATAFORSEO_LANGUAGE_CODE=en
# Embeddings for "closest post on my blog" (any OpenAI-compatible /embeddings API)
# FC_EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
# FC_EMBEDDING_API_KEY=
# FC_EMBEDDING_MODEL=qwen/qwen3-embedding-8b
# 30-day strategy summaries (any OpenAI-compatible /chat/completions API)
# FC_LLM_BASE_URL=https://api.deepseek.com/v1
# FC_LLM_API_KEY=
# FC_LLM_MODEL=deepseek-chat
